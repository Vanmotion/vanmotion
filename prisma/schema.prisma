generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id   String  @id @default(cuid())
  name String
  slug String  @unique
  logo String?

  vehicles Vehicle[]
}

model Vehicle {
  id String @id @default(cuid())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  model   String
  version String?

  year    Int
  mileage Int

  fuel         String
  transmission String

  drivetrain String?
  engine     String?
  power      Int?
  color      String?

  price         Decimal  @db.Decimal(12, 2)
  previousPrice Decimal? @db.Decimal(12, 2)

  featured Boolean @default(false)
  status   String  @default("AVAILABLE")

  description   String?
  descriptionEn String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images   VehicleImage[]
  contacts ContactRequest[]
}

model VehicleImage {
  id String @id @default(cuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url String
  alt String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
}

model ContactRequest {
  id String @id @default(cuid())

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  subject String?

  name  String
  email String
  phone String?

  message String

  status String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model SiteSettings {
  id           String @id
  businessName String @default("VANMOTION")

  email    String?
  phone    String?
  whatsapp String?

  address    String?
  city       String?
  postalCode String?

  instagram String?
  youtube   String?
  tiktok    String?

  openingHours String?

  updatedAt DateTime @updatedAt
}

model MusicRecommendation {
  id String @id @default(cuid())

  title  String
  artist String

  youtubeVideoId String  @unique
  coverUrl       String?

  editorialHeading  String?
  editorialTextEs   String?
  editorialTextEn   String?
  editorialCredit   String?
  editorialStyle    String?
  documentImageUrl  String?
  documentSourceUrl String?
  documentAuthentic Boolean @default(false)

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model MusicTrack {
  id String @id @default(cuid())

  slug String @unique

  title    String
  subtitle String?

  fileUrl  String
  coverUrl String?

  externalUrl String?

  format   String  @default("MP3")
  duration String?

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Catálogo de productos VANMOTION.
 * Estados recomendados:
 * - DRAFT
 * - COMING_SOON
 * - AVAILABLE
 * - SOLD_OUT
 * - HIDDEN
 */
model Product {
  id String @id @default(cuid())

  slug String @unique

  name       String
  subtitle   String?
  collection String?

  category    String @default("CLOTHING")
  productType String @default("TSHIRT")

  description   String?
  descriptionEn String?

  material String?
  color    String?

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("EUR")

  status   String  @default("COMING_SOON")
  featured Boolean @default(false)
  active   Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
  images   ProductImage[]

  @@index([status, active])
  @@index([category])
  @@index([sortOrder])
}

/**
 * Stock independiente por talla.
 * Para la primera camiseta:
 * - S
 * - M
 * - L
 * - XL
 */
model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size String
  sku  String? @unique

  stock  Int     @default(0)
  active Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size])
  @@index([productId])
  @@index([active])
}

/**
 * Galería del producto.
 * view puede contener:
 * - FRONT
 * - BACK
 * - DETAIL
 * - LIFESTYLE
 */
model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url  String
  alt  String?
  view String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([sortOrder])
}

/**
 * Pedido confirmado mediante Stripe Checkout.
 */
model Order {
  id String @id @default(cuid())

  stripeCheckoutSessionId String  @unique
  stripePaymentIntentId   String? @unique
  stripeCustomerId        String?

  paymentStatus     String
  fulfillmentStatus String @default("PENDING")

  amountTotal Int
  currency    String @default("eur")

  customerEmail String?
  customerName  String?
  customerPhone String?

  /**
   * Idioma utilizado durante la compra.
   * Permite mantener los correos del pedido
   * en español o inglés durante todo el proceso.
   */
  customerLanguage String @default("es")

  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingPostalCode String?
  shippingCity       String?
  shippingState      String?
  shippingCountry    String?

  /**
   * Información del transporte.
   * Son opcionales para conservar los pedidos anteriores.
   */
  shippingCarrier String?
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?

  productId   String
  productSlug String
  productName String

  variantId String
  sku       String?
  size      String
  quantity  Int

  /**
   * Prueba de la aceptación de las condiciones
   * realizada antes de abrir Stripe Checkout.
   * Los campos son opcionales para conservar
   * los pedidos creados antes de esta función.
   */
  termsAcceptedAt       DateTime?
  termsVersion          String?
  termsAcceptanceSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Cada pedido puede tener como máximo
   * una solicitud de desistimiento.
   */
  withdrawalRequest WithdrawalRequest?

  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([customerEmail])
  @@index([trackingNumber])
  @@index([createdAt])
}

/**
 * Estado de una solicitud de desistimiento.
 */
enum WithdrawalStatus {
  RECEIVED
  UNDER_REVIEW
  RETURN_RECEIVED
  REFUNDED
  REJECTED
}

/**
 * Solicitud electrónica de desistimiento.
 * Se vincula directamente con el pedido y conserva
 * la declaración y la fecha exacta de recepción.
 */
model WithdrawalRequest {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  status WithdrawalStatus @default(RECEIVED)

  customerName  String
  customerEmail String

  /**
   * Declaración inequívoca enviada por el cliente.
   */
  statement String

  /**
   * Comentario voluntario del cliente.
   * No se exige explicar el motivo del desistimiento.
   */
  customerMessage String?

  /**
   * Idioma utilizado para el formulario
   * y el correo de confirmación.
   */
  language String @default("es")

  /**
   * Fecha exacta en la que se recibió la solicitud.
   */
  requestedAt DateTime @default(now())

  /**
   * Fecha en la que se envió la confirmación
   * automática al cliente.
   */
  confirmationSentAt DateTime?

  /**
   * Fechas de gestión interna.
   */
  returnReceivedAt DateTime?
  refundedAt       DateTime?
  rejectedAt       DateTime?
  resolvedAt       DateTime?

  adminNotes String?

  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerEmail])
  @@index([requestedAt])
}

model NewsArticle {
  id             String   @id @default(cuid())
  locale         String
  region         String
  category       String
  title          String
  summary        String
  source         String
  sourceUrl      String   @unique
  imageUrl       String?
  publishedAt    DateTime
  fetchedAt      DateTime @default(now())
  editorialScore Int
  slug           String   @unique
  isActive       Boolean  @default(true)

  @@index([locale])
  @@index([region])
  @@index([category])
  @@index([publishedAt])
  @@index([editorialScore])
  @@index([isActive])
  @@index([locale, region, category, isActive, editorialScore])
}

enum CommunityCategory {
  MUSIC
  FASHION
  AUTOMOTIVE
}

enum CommunityUserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum CommunityUserStatus {
  ACTIVE
  SUSPENDED
}

enum CommunityTopicStatus {
  OPEN
  LOCKED
  HIDDEN
}

model CommunityUser {
  id String @id @default(cuid())

  email       String  @unique
  username    String  @unique
  displayName String?

  passwordHash String?

  role   CommunityUserRole   @default(MEMBER)
  status CommunityUserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics   CommunityTopic[]
  replies  CommunityReply[]
  sessions CommunitySession[]

  @@index([createdAt])
  @@index([status])
}

model CommunityTopic {
  id String @id @default(cuid())

  category CommunityCategory

  title String
  body  String

  status CommunityTopicStatus @default(OPEN)

  authorId String
  author   CommunityUser @relation(fields: [authorId], references: [id], onDelete: Cascade)

  replies     CommunityReply[]
  attachments CommunityAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, createdAt])
  @@index([authorId])
  @@index([status])
}

model CommunityAttachment {
  id String @id @default(cuid())

  url  String
  type String @default("IMAGE")

  topicId String
  topic   CommunityTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([topicId])
}

model CommunityReply {
  id String @id @default(cuid())

  body String

  topicId String
  topic   CommunityTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  authorId String
  author   CommunityUser @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId, createdAt])
  @@index([authorId])
}

model CommunityLoginCode {
  id String @id @default(cuid())

  email    String
  codeHash String

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model CommunitySession {
  id String @id @default(cuid())

  tokenHash String @unique

  userId String
  user   CommunityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
