{
  "name": "vanmotion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:local": "DATABASE_URL=postgresql://jose@localhost:5432/vanmotion PUBLIC_SITE_ENABLED=true next dev -H 127.0.0.1",
    "dev:local:closed": "DATABASE_URL=postgresql://jose@localhost:5432/vanmotion PUBLIC_SITE_ENABLED=false next dev -H 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:local:migrate": "DATABASE_URL=postgresql://jose@localhost:5432/vanmotion prisma migrate deploy",
    "db:local:seed": "DATABASE_URL=postgresql://jose@localhost:5432/vanmotion tsx prisma/seed.ts",
    "db:local:studio": "DATABASE_URL=postgresql://jose@localhost:5432/vanmotion prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "dotenv": "^17.4.2",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.17.2",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "playwright": "^1.45.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
