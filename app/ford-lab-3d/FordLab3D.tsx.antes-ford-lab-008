/* eslint-disable @next/next/no-img-element -- User-owned VANMOTION vehicle photos and bundled local rim thumbnails. */
"use client";

import { useEffect, useRef, useState } from "react";
import Link from "next/link";
import dynamic from "next/dynamic";
import LocalSoundStudio from "./LocalSoundStudio";
import { useLanguage } from "@/app/components/language/LanguageProvider";
import { useMusicPlayer } from "@/app/components/music/MusicPlayerContext";
import type { Build, CameraView, Fit, Language, ModelStatus, StudioTab, WheelChoice } from "./types";
import { DEFAULT_BUILD, DEFAULT_FIT, VANMOTION_FORD_IMAGES, describeColor } from "./types";
import styles from "./ford-lab-3d.module.css";

const FordScene = dynamic(()=>import("./FordScene"),{ssr:false});
// Local reference images: no third-party image requests or outgoing links.
const PARTS={
  ar172:{title:"American Racing AR172 Baja",sku:"AR1725885",image:"/ford-lab-3d/rims/ar172-mounted.png"},
  ar23:{title:"American Racing AR23",sku:"AR236885",image:"/ford-lab-3d/rims/ar23-mounted.png"},
  rack:{title:"Vantech H1 Ladder Rack",sku:"H1082B"},
  steps:{title:"Chrome tubular running boards",sku:"MODEL / FITMENT TO VERIFY"},
  filter:{title:"K&N High-Flow Air Filter",sku:"E-0945"},
  shocks:{title:"Bilstein B6 4600",sku:"24-184816 / 33-017204"},
  muffler:{title:"Walker SoundFX",sku:"18819"},
};
const PAINT_LABELS:Record<string,{es:string;en:string}>={
  "#172b4d":{es:"Azul Atlántico",en:"Atlantic Blue"},
  "#090b0e":{es:"Negro Obsidiana",en:"Obsidian Black"},
  "#f1ede7":{es:"Blanco Oxford",en:"Oxford White"},
  "#707677":{es:"Plata Grafito",en:"Graphite Silver"},
  "#5e201a":{es:"Rojo Burdeos",en:"Burgundy Red"},
};
function paintLabel(hex:string,language:Language):string {
  return PAINT_LABELS[hex]?.[language] ?? hex;
}
const PAINTS=[{hex:"#172b4d",title:"Atlantic Blue"},{hex:"#090b0e",title:"Obsidian Black"},{hex:"#f1ede7",title:"Oxford White"},{hex:"#707677",title:"Graphite Silver"},{hex:"#5e201a",title:"Burgundy Red"}] as const;

type Saved={build?:Partial<Build>;fit?:Partial<Fit>};
function isWheelChoice(value:unknown):value is WheelChoice{return value==="oem"||value==="ar172"||value==="ar23";}

export default function FordLab3D() {
  const {language} = useLanguage();
  const {pausePlayback}=useMusicPlayer();
  const pausePlayerRef=useRef(pausePlayback);
  pausePlayerRef.current=pausePlayback;
  // This workshop has its own audio comparison, so suppress only the floating
  // VANMOTION music player while this page is mounted. Do not edit shared routes.
  useEffect(()=>{
    pausePlayerRef.current();
    const floating=document.querySelector<HTMLElement>("[data-music-player-mode]");
    const previous=floating?.style.display ?? "";
    if(floating)floating.style.display="none";
    return()=>{if(floating)floating.style.display=previous;};
  },[]);
  const lang:Language = language === "en"?"en":"es";
  const t=(es:string,en:string)=>lang==="es"?es:en;
  const [tab,setTab]=useState<StudioTab>("exterior");
  const [build,setBuild]=useState<Build>(DEFAULT_BUILD);
  const [fit,setFit]=useState<Fit>(DEFAULT_FIT);
  const [modelFile,setModelFile]=useState<File|null>(null);
  const [modelStatus,setModelStatus]=useState<ModelStatus>({kind:"loading",message:"Buscando modelo 3D..."});
  const [cameraView,setCameraView]=useState<CameraView>("threequarter");
  const [compare,setCompare]=useState(false);
  const [showAdvanced,setShowAdvanced]=useState(false);
  const [engineActive,setEngineActive]=useState<"intake"|"muffler"|"dampers">("intake");
  const [saved,setSaved]=useState(false);
  const [droppedError,setDroppedError]=useState("");
  const uploadRef=useRef<HTMLInputElement>(null);
  const importBuildRef=useRef<HTMLInputElement>(null);

  useEffect(()=>{
    try {
      const value=window.localStorage.getItem("vanmotion:ford-lab:3d:v2") || window.localStorage.getItem("vanmotion:ford-lab:3d:v1");
      if(!value)return;
      const parsed=JSON.parse(value) as Saved;
      if(parsed.build){
        setBuild(prev=>({
          ...prev,...parsed.build,
          wheels:isWheelChoice(parsed.build?.wheels)?parsed.build.wheels:prev.wheels,
        }));
      }
      if(parsed.fit)setFit(prev=>({...prev,...parsed.fit}));
    }catch{ /* ignore invalid local preferences */ }
  },[]);
  useEffect(()=>{
    try {window.localStorage.setItem("vanmotion:ford-lab:3d:v2",JSON.stringify({build,fit}));}
    catch { /* private browser */ }
  },[build,fit]);

  const patch=<K extends keyof Build,>(key:K,value:Build[K])=>{setBuild(prev=>({...prev,[key]:value}));setSaved(false);};
  const patchFit=<K extends keyof Fit,>(key:K,value:Fit[K])=>{setFit(prev=>({...prev,[key]:value}));setSaved(false);};
  const importModel=(file:File|undefined)=>{
    if(!file)return;
    const lower=file.name.toLowerCase();
    if(lower.endsWith(".rar")||lower.endsWith(".zip")||lower.endsWith(".blend")){
      setDroppedError(t("Extrae el archivo y selecciona el modelo .obj. El .rar o .blend no se abre directamente en la web.","Extract the archive and choose its .obj model. .rar and .blend cannot load directly in the browser."));
      return;
    }
    if(!lower.endsWith(".obj")&&!lower.endsWith(".glb")&&!lower.endsWith(".gltf")){
      setDroppedError(t("Formato incompatible. Selecciona un archivo .obj o .glb.","Unsupported format. Select an .obj or .glb file."));
      return;
    }
    setDroppedError("");setModelFile(file);setTab("exterior");
  };
  const save=()=>{
    const data={studio:"VANMOTION FORD LAB 006 · PRIVATE 3D WORKSHOP",model:modelFile?.name||"/ford-lab-3d/model/econoline.obj",
      build:{...build,paintName:describeColor(build.paint)},fit,
      notes:"Private visual study. Commercial compatibility, fitment and part geometry are not verified. Free3D model personal-use license; publication requires permission.",
      exportedAt:new Date().toISOString()};
    const url=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:"application/json"}));
    const a=document.createElement("a");a.href=url;a.download="VANMOTION-FORD-LAB-3D-BUILD.json";a.click();
    URL.revokeObjectURL(url);setSaved(true);
  };
  const importBuild=async(file?:File)=>{
    if(!file)return;
    try{
      const raw=JSON.parse(await file.text()) as Saved;
      if(!raw.build || typeof raw.build!=="object")throw new Error("build");
      const next={...DEFAULT_BUILD,...raw.build};
      if(!isWheelChoice(next.wheels))throw new Error("wheels");
      if(next.tires!=="road"&&next.tires!=="allterrain")throw new Error("tires");
      if(typeof next.paint!=="string" || !/^#[a-fA-F0-9]{6}$/.test(next.paint))throw new Error("paint");
      setBuild(next);
      if(raw.fit)setFit(prev=>({...prev,...raw.fit}));
      setSaved(false);
      setDroppedError("");
    }catch{setDroppedError(t("No se pudo abrir esta preparación JSON.","This JSON build could not be opened."));}
  };
  const ENGINE_TOPICS=[
    {id:"intake" as const,label:t("ADMISIÓN","AIR INTAKE"),part:build.intake==="kn"?"K&N E-0945":t("Filtro de origen","Factory filter"),detail:t("Filtro reemplazable. No se promete aumento de potencia sin medición.","Replacement air filter. No horsepower gains claimed without testing.")},
    {id:"muffler" as const,label:t("ESCAPE","EXHAUST"),part:build.muffler==="walker"?"Walker SoundFX 18819":t("Silenciador de origen","Factory muffler"),detail:t("Componente bajo el vehículo; no se representa dentro del vano motor.","Underbody component; it is not shown inside the engine bay.")},
    {id:"dampers" as const,label:t("AMORTIGUACIÓN","DAMPERS"),part:build.dampers==="bilstein"?"Bilstein B6 4600":t("Amortiguadores de origen","Factory dampers"),detail:t("Componente de chasis: conserva la altura original en esta simulación.","Chassis component: factory ride height is preserved in this simulation.")},
  ];
  const engineSelected=ENGINE_TOPICS.find(x=>x.id===engineActive)!;
  return <main className={styles.page}>
    <header className={styles.header}>
      <div className={styles.brand}><Link href="/">VANMOTION<span>.</span></Link><small>FORD LAB / 006</small></div>
      <div className={styles.meta}><span>{t("ESTUDIO PRIVADO · LOCAL","PRIVATE STUDIO · LOCAL")}</span><Link href="/coleccion/cmrm2i93y0001jq04awn01yv0">{t("FICHA DE LA FORD","FORD LISTING")} ↗</Link></div>
    </header>
    <section className={styles.heading}>
      <div><span className={styles.overline}>{t("VANMOTION · TALLER INTERACTIVO","VANMOTION · INTERACTIVE CUSTOM GARAGE")}</span><h1>{t("LA FORD","THE FORD")}<span>.</span><br/><em>{t("TALLER 3D","3D WORKSHOP")}</em></h1><p>{t("Una Econoline real como base del taller: explora el exterior 360°, prueba preparaciones y examina el motor. La personalización del modelo 3D es una prueba visual, no una homologación de piezas.","A real Econoline model as the workshop's base: explore the exterior in 360°, try custom builds and inspect the engine. 3D modifications are visual studies, not certified fitments.")}</p></div>
      <div className={styles.vehicleSpec}><strong>E-150</strong><span>{t("GENERACIÓN 1998–2000","1998–2000 GENERATION")}</span><small>ESSEX 4.2 V6 · RWD</small></div>
    </section>
    <div className={styles.workspace}>
      <section className={styles.display}>
        <div className={styles.displayTop}><span>01 / {tab==="exterior"?t("VISTA 360°","360° VIEW"):tab==="engine"?t("VANO MOTOR","ENGINE BAY"):t("ESTUDIO DE SONIDO","SOUND STUDY")}</span><span>{t("FOTOGRAFÍAS DE VANMOTION","VANMOTION PHOTOGRAPHS")}</span></div>
        {tab==="exterior" ? <>
          <div className={styles.viewer} onDragOver={e=>e.preventDefault()} onDrop={e=>{e.preventDefault();importModel(e.dataTransfer.files[0]);}}>
            <FordScene build={build} fit={fit} sourceFile={modelFile} cameraView={cameraView} compare={compare} onStatus={setModelStatus}/>
            {modelStatus.kind!=="ready"&&<div className={styles.missingModel}>
              <img src={VANMOTION_FORD_IMAGES[2]} alt={t("Fotografía de tu Ford E-150 azul","Photo of your blue Ford E-150")}/>
              <div className={styles.missingShade}/>
              <div className={styles.missingContent}>
                <small>{modelStatus.kind==="error"?t("ERROR DEL MODELO","MODEL ERROR"):modelStatus.kind==="loading"?t("CARGANDO","LOADING"):t("MODELO NECESARIO","MODEL REQUIRED")}</small>
                <strong>{modelStatus.kind==="error"?t("NO SE HA PODIDO CARGAR","COULD NOT LOAD"):t("IMPORTA TU FORD 3D","IMPORT YOUR 3D FORD")}</strong>
                <p>{modelStatus.kind==="error"?modelStatus.message:t("El modelo original de la Econoline está incluido en este taller local. Si no carga, puedes abrir un archivo OBJ o GLB.","The original Econoline model is included in this local workshop. If it does not load, you can import an OBJ or GLB file.")}</p>
                <button type="button" className={styles.orangeButton} onClick={()=>uploadRef.current?.click()}>{t("IMPORTAR OBJ / GLB","IMPORT OBJ / GLB")} ↗</button>
              </div>
            </div>}
            {modelStatus.kind==="ready"&&<div className={styles.readyMark}><span className={styles.liveDot}/> {t("MODELO 3D CARGADO · ARRASTRA PARA GIRAR","3D MODEL LOADED · DRAG TO ROTATE")}</div>}
          </div>
          <div className={styles.views}>{(["threequarter","side","front","rear","other","top"] as CameraView[]).map(v=><button type="button" key={v} aria-pressed={cameraView===v} className={cameraView===v?styles.active:""} onClick={()=>setCameraView(v)}>{({threequarter:t("3/4","3/4"),side:t("LATERAL","SIDE"),front:t("FRENTE","FRONT"),rear:t("TRASERA","REAR"),other:t("OTRO LADO","OTHER SIDE"),top:t("TECHO","ROOF")})[v]}</button>)}</div>
          <div className={styles.viewerFooter}>
            <div><strong>{t("CONTROL 360°","360° CONTROL")}</strong><small>{t("Arrastra para girar · rueda del ratón para acercar","Drag to orbit · mouse wheel to zoom")}</small></div>
            <div className={styles.viewerActions}>
              <button type="button" disabled={modelStatus.kind!=="ready"} onClick={()=>window.dispatchEvent(new Event("vanmotion-ford-save-image"))}>{t("GUARDAR IMAGEN","SAVE IMAGE")}</button>
              <button type="button" onPointerDown={()=>setCompare(true)} onPointerUp={()=>setCompare(false)} onPointerLeave={()=>setCompare(false)} onPointerCancel={()=>setCompare(false)}>{t("MANTENER: ORIGINAL","HOLD: ORIGINAL")}</button>
            </div>
          </div>
          {modelFile&&<p className={styles.modelFile}><span>{t("Modelo cargado:","Loaded model:")}</span> {modelFile.name}</p>}
          {droppedError&&<p className={styles.error}>{droppedError}</p>}
        </> : tab==="engine" ? <>
          <div className={styles.enginePicture}><img src={VANMOTION_FORD_IMAGES[3]} alt={t("Vano motor de la Ford E-150 de VANMOTION","VANMOTION Ford E-150 engine bay")}/><span>{t("FOTOGRAFÍA ORIGINAL DE VANMOTION","ORIGINAL VANMOTION PHOTOGRAPH")}</span></div>
          <div className={styles.engineExplorer}>
            <div className={styles.engineTopics}>{ENGINE_TOPICS.map(x=><button type="button" key={x.id} aria-pressed={engineActive===x.id} className={engineActive===x.id?styles.engineTopicActive:""} onClick={()=>setEngineActive(x.id)}>{x.label}</button>)}</div>
            <div className={styles.engineDetail}><strong>{engineSelected.part}</strong><p>{engineSelected.detail}</p></div>
            <p className={styles.engineNote}>{t("La foto se mantiene intacta. Los cambios mecánicos quedan registrados en tu preparación; no inventamos piezas colocadas en lugares incorrectos.","The photograph stays untouched. Mechanical changes are recorded in your build; we do not depict components in incorrect locations.")}</p>
          </div>
        </> : <>
          <LocalSoundStudio language={lang}/>
        </>}
        <div className={styles.displayBottom}><span>{t("VANMOTION / TALLER PRIVADO","VANMOTION / PRIVATE WORKSHOP")}</span><span>{t("NUNCA EN PRODUCCIÓN SIN VALIDAR","NOT FOR PUBLIC RELEASE WITHOUT VALIDATION")}</span></div>
      </section>
      <aside className={styles.controls}>
        <div className={styles.panelHead}><span className={styles.overline}>{t("CONFIGURADOR / 006","CUSTOM BUILDER / 006")}</span><h2>{t("PERSONALIZA","BUILD IT")}<span>.</span></h2><button type="button" onClick={()=>{setBuild(DEFAULT_BUILD);setFit(DEFAULT_FIT);}}>{t("REINICIAR","RESET")} ↺</button></div>
        <div className={styles.tabs}>{(["exterior","engine","sound"] as StudioTab[]).map((x,i)=><button key={x} className={tab===x?styles.activeTab:""} aria-pressed={tab===x} onClick={()=>setTab(x)}><small>0{i+1}</small><strong>{({exterior:t("EXTERIOR 3D","3D EXTERIOR"),engine:t("MOTOR","ENGINE"),sound:t("SONIDO","SOUND")})[x]}</strong></button>)}</div>
        {tab==="exterior" ? <div className={styles.panelBody}>
          <div className={styles.group}><div className={styles.groupHeading}><strong>01 / {t("PINTURA","PAINT")}</strong><small>{paintLabel(build.paint,lang)}</small></div><div className={styles.swatches}>{PAINTS.map(c=><button type="button" key={c.hex} title={paintLabel(c.hex,lang)} aria-label={paintLabel(c.hex,lang)} aria-pressed={build.paint===c.hex} onClick={()=>patch("paint",c.hex)} className={build.paint===c.hex?styles.selectedPaint:""} style={{background:c.hex}}/>)}</div><p>{t("Pintura de previsualización sobre los materiales editables del modelo.","Paint preview over the model's editable body materials.")}</p></div>
          <div className={styles.group}><div className={styles.groupHeading}><strong>02 / {t("LLANTAS","WHEELS")}</strong><small>{t("5×139,7 · COMPATIBILIDAD POR VERIFICAR","5×139.7 · FITMENT PENDING")}</small></div><div className={styles.partList}>
            <button type="button" className={build.wheels==="oem"?styles.selectedOption:""} onClick={()=>patch("wheels","oem")}><span className={styles.oemThumbnail}>OEM</span><span><strong>{t("Originales de la Ford","Factory wheels")}</strong><small>{t("Geometría del modelo base","Base-model geometry")}</small></span><i>{build.wheels==="oem"?"●":"○"}</i></button>
            {(["ar172","ar23"] as const).map(choice=><button type="button" key={choice} className={build.wheels===choice?styles.selectedOption:""} onClick={()=>patch("wheels",choice)}><img src={PARTS[choice].image} alt={PARTS[choice].title}/><span><strong>{PARTS[choice].title}</strong><small>{PARTS[choice].sku}</small></span><i>{build.wheels===choice?"●":"○"}</i></button>)}
          </div><p>{t("Llanta real de catálogo sobre un aro tridimensional. El diseño cambia al elegir AR172 o AR23; ajuste y homologación pendientes.","Real commercial wheel photograph on a 3D rim barrel. AR172 and AR23 have distinct designs; exact fitment remains unverified.")}</p>
          <div className={styles.tireGroup}><strong>{t("NEUMÁTICOS","TIRES")}</strong><div className={styles.tireChooser}>
            <button type="button" className={build.tires==="road"?styles.tireSelected:""} onClick={()=>patch("tires","road")} aria-pressed={build.tires==="road"}><b>{t("CARRETERA","ROAD")}</b><small>{t("Banda original · firme","Original smooth tread")}</small></button>
            <button type="button" className={build.tires==="allterrain"?styles.tireSelected:""} onClick={()=>patch("tires","allterrain")} aria-pressed={build.tires==="allterrain"}><b>{t("TODOTERRENO A/T","ALL-TERRAIN A/T")}</b><small>{t("Tacos 3D · más agarre visual","Raised 3D tread blocks")}</small></button>
          </div></div>
          <p>{build.tires==="allterrain"?t("Dibujo de tacos integrado en los cuatro neumáticos originales, sin duplicar las ruedas. Patrón 3D conceptual, no modelo comercial homologado.","Visible tread blocks added to all four original tyres without duplicate wheels. Concept 3D pattern, not a certified commercial tyre."):t("Neumáticos de carretera originales del modelo.","Original road tyres from the model.")}</p></div>
          <div className={styles.group}><strong className={styles.sectionTitle}>03 / {t("ACCESORIOS","ACCESSORIES")}</strong><Toggle checked={build.rack} onChange={v=>patch("rack",v)} title={t("Baca Vantech H1","Vantech H1 Roof Rack")} subtitle={t("Baca más estrecha y centrada · montaje 3D de prueba","Narrower centred rack · 3D fitment preview")} onLabel={t("SÍ","ON")} offLabel={t("NO","OFF")}/><Toggle checked={build.steps} onChange={v=>patch("steps",v)} title={t("Estriberas tubulares cromadas","Chrome tubular running boards")} subtitle={t("Cromadas y visibles junto al faldón lateral","Polished chrome, visible beside the lower sill")} onLabel={t("SÍ","ON")} offLabel={t("NO","OFF")}/><Toggle checked={build.exhaust==="chrome"} onChange={v=>patch("exhaust",v?"chrome":"original")} title={t("Salida de escape cromada corta","Short chrome exhaust tip")} subtitle={t("Punta corta · compatibilidad por verificar","Short exhaust tip · fitment pending")} onLabel={t("SÍ","ON")} offLabel={t("NO","OFF")}/></div>
          <div className={styles.group}><button className={styles.advancedTrigger} onClick={()=>setShowAdvanced(v=>!v)} type="button">{t("AJUSTE DEL MODELO 3D","3D MODEL FITMENT")} {showAdvanced?"−":"+"}</button>
            {showAdvanced&&<div className={styles.fitControls}><p>{t("Solo es necesario cambiar la orientación si importas un modelo diferente. Las ruedas ya utilizan los bujes originales de esta Ford.","Only change orientation if you import a different model. Wheels already use the original hubs of this Ford.")}</p>
              <label className={styles.inlineSelect}>{t("EJES DEL MODELO","MODEL AXES")}<select value={fit.orientation} onChange={e=>patchFit("orientation",e.target.value as Fit["orientation"])}><option value="auto">{t("Eje Y vertical (OBJ)","Y-UP (OBJ)")}</option><option value="zup">{t("Eje Z vertical (Blender)","Z-UP (Blender)")}</option></select></label>
              <Toggle checked={fit.invertDirection} onChange={v=>patchFit("invertDirection",v)} title={t("Invertir frente y trasera","Swap model front/rear")} subtitle={t("Giro de 180° del OBJ","Rotate imported OBJ by 180°")} onLabel={t("SÍ","ON")} offLabel={t("NO","OFF")}/>
            </div>}
          </div>
          <div className={styles.sources}><strong>{t("PIEZAS DE REFERENCIA · SIN ENLACES EXTERNOS","PART REFERENCES · NO EXTERNAL LINKS")}</strong>
            <p>American Racing AR172 Baja · AR1725885</p><p>American Racing AR23 · AR236885</p><p>Vantech H1 · H1082B</p>
            <p className={styles.notice}>{t("Los accesorios son previsualizaciones dimensionales y no sustituyen la comprobación real de compatibilidad.","Accessories are dimensional visual previews; real fitment still needs checking.")}</p>
          </div>
        </div> : tab==="engine" ? <div className={styles.panelBody}>
          <span className={styles.panelLabel}>{t("ESSEX 4.2 V6 · PREPARACIÓN MECÁNICA","ESSEX 4.2 V6 · MECHANICAL BUILD")}</span>
          <h3>{t("PIEZAS DEL MOTOR.","ENGINE PARTS.")}</h3>
          <p>{t("Selecciona piezas reales de referencia. La elección queda guardada en tu preparación, sin inventar cambios de potencia ni de sonido.","Choose referenced real parts. Your selection is saved to the build without invented power or sound changes.")}</p>
          <section className={styles.enginePartGroup}><strong>{t("01 · ADMISIÓN","01 · INTAKE")}</strong>
            <Toggle checked={build.intake==="kn"} onChange={v=>{patch("intake",v?"kn":"oem");setEngineActive("intake");}} title="K&N High-Flow · E-0945" subtitle={t("Filtro de sustitución · aplicación a verificar","Replacement air filter · check application")} onLabel={t("ELEGIDO","SELECTED")} offLabel="OEM"/>
          </section>
          <section className={styles.enginePartGroup}><strong>{t("02 · ESCAPE","02 · EXHAUST")}</strong>
            <Toggle checked={build.muffler==="walker"} onChange={v=>{patch("muffler",v?"walker":"oem");setEngineActive("muffler");}} title="Walker SoundFX · 18819" subtitle={t("Silenciador de recambio · compatibilidad pendiente","Replacement muffler · fitment unconfirmed")} onLabel={t("ELEGIDO","SELECTED")} offLabel="OEM"/>
          </section>
          <section className={styles.enginePartGroup}><strong>{t("03 · CHASIS","03 · CHASSIS")}</strong>
            <Toggle checked={build.dampers==="bilstein"} onChange={v=>{patch("dampers",v?"bilstein":"oem");setEngineActive("dampers");}} title="Bilstein B6 4600" subtitle={t("24-184816 / 33-017204 · altura original","24-184816 / 33-017204 · factory ride height")} onLabel={t("ELEGIDO","SELECTED")} offLabel="OEM"/>
          </section>
          <p className={styles.notice}>{t("Las referencias comerciales no demuestran compatibilidad con esta unidad; confirmar antes de adquirir o montar.","Commercial references do not prove fitment on this vehicle; verify before purchase or installation.")}</p>
        </div> : <div className={styles.panelBody}>
          <span className={styles.panelLabel}>ESSEX 4.2 V6</span>
          <h3>{t("AUDIO PROPIO.","YOUR AUDIO.")}</h3>
          <p>{t("Utiliza el comparador de la izquierda con dos grabaciones reales. No hay vídeos, enlaces a terceros ni sonidos sintéticos presentados como auténticos.","Use the comparator on the left with two genuine recordings. No videos, third-party links or synthetic audio presented as authentic.")}</p>
          <div className={styles.sources}><strong>{t("PREPARACIÓN ACTUAL","CURRENT BUILD")}</strong>
            <p>{build.muffler==="walker"?"Walker SoundFX 18819":t("Escape original","Factory exhaust")}</p>
            <p>{build.exhaust==="chrome"?t("Salida corta cromada","Short chrome tip"):t("Salida de origen","Factory tip")}</p>
          </div>
          <p className={styles.notice}>{t("Para oír una diferencia real necesitaremos grabaciones comparables de ambas configuraciones.","To hear a genuine difference we need comparable recordings of both configurations.")}</p>
        </div>}
        <div className={styles.panelBottom}><button type="button" onClick={save}>{saved?t("GUARDADO ✓","SAVED ✓"):t("GUARDAR PREPARACIÓN","SAVE BUILD")} ↗</button><small>{t("Guarda las piezas y los ajustes como archivo JSON.","Save selected parts and settings as a JSON file.")}</small></div>
      </aside>
    </div>
    <section className={styles.modelHelp}>
      <div><span className={styles.overline}>{t("MODELO DIGITAL / 1998","THE DIGITAL BASE / 1998")}</span><h2>{t("MODELO 3D INSTALADO.","LOCAL 3D MODEL.")}</h2><p>{t("La Ford ya viene incluida en esta versión local. Puedes importar otra geometría o recuperar tus elecciones guardadas. Para publicación comercial hace falta autorización de uso del modelo 3D.","This local version includes the Ford. You may import another model or restore your saved configuration. Commercial publication requires model-use authorization.")}</p></div>
      <div className={styles.modelActions}><button type="button" onClick={()=>uploadRef.current?.click()}>{t("ABRIR OTRO OBJ / GLB","OPEN ANOTHER OBJ / GLB")}</button><button type="button" onClick={()=>importBuildRef.current?.click()}>{t("RECUPERAR PREPARACIÓN","LOAD SAVED BUILD")}</button><small>{t("Todo se procesa en este navegador. Ningún enlace a terceros.","Everything runs in this browser. No third-party links.")}</small></div>
    </section>
    <input ref={uploadRef} type="file" accept=".obj,.glb,.gltf" onChange={e=>{importModel(e.target.files?.[0]);e.target.value="";}} hidden />
    <input ref={importBuildRef} type="file" accept=".json,application/json" onChange={e=>{void importBuild(e.target.files?.[0]);e.target.value="";}} hidden />
    <footer className={styles.footer}><span>VANMOTION / FORD LAB 006</span><span>{t("SOLO LOCAL. NO PUBLICADO.","LOCAL ONLY. NOT PUBLISHED.")}</span><Link href="/coleccion/cmrm2i93y0001jq04awn01yv0">{t("VER FICHA DE LA FORD","VIEW FORD LISTING")} ↗</Link></footer>
  </main>;
}

function Toggle({checked,onChange,title,subtitle,onLabel,offLabel}:{checked:boolean;onChange:(v:boolean)=>void;title:string;subtitle:string;onLabel:string;offLabel:string}){
  return <button type="button" className={`${styles.toggle} ${checked?styles.toggleOn:""}`} aria-pressed={checked} onClick={()=>onChange(!checked)}><span><strong>{title}</strong><small>{subtitle}</small></span><i>{checked?onLabel:offLabel}</i></button>;
}
